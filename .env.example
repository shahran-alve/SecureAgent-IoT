# Optional: only needed for the real-LLM responder (src/secureagent_iot/llm_adapter.py).
# Without these the artifact runs scripted agents and reports "LLM-backed evaluation unrun".
LLM_PROVIDER=            # anthropic | openai | hf
LLM_MODEL=               # exact model id, recorded per call
LLM_PROMPT=              # prompt condition, required with --llm: base | defended | policy | policy_defended
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
